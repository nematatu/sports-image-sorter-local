# Copy to .env and fill in only the providers you actually want to use.
# NOTHING in this file is required for the default (local, offline) engines.
# .env is gitignored; never commit real keys.

# --- Local engines (default) -------------------------------------------------
# Device for local neural engines: auto | cpu | mps
SPORTS_SORTER_DEVICE=auto
# Where Hugging Face weights are cached (defaults to ~/.cache/huggingface)
# SPORTS_SORTER_MODEL_DIR=~/.cache/huggingface

# --- Optional cloud engines (OFF by default) ---------------------------------
# Sending real photos to a third party requires explicit human approval.
# See docs/engines.md and docs/safety.md before enabling these.
#
# SPORTS_SORTER_ALLOW_CLOUD=0        # must be 1 to enable any cloud engine
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# TYPESAFE_API_KEY=
# TYPESAFE_DANGER_ZONE_IMAGES=1      # required for Jev image input (experimental)
